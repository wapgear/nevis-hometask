{
  "name": "nevis-client-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include 'server/**/*.json' server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:ui": "playwright test --ui",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "express": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "sass": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
